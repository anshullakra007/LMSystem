@model LMSystem.Web.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="hero-banner d-flex justify-content-between align-items-center">
    <div>
        <h2 class="fw-bold mb-2"><i class="bi bi-book-half text-warning me-2"></i>Library Dashboard</h2>
        <p class="mb-0 fs-5 text-light">Welcome back! Here's what's happening today.</p>
    </div>
    <div class="d-none d-md-block">
        <a asp-controller="Borrow" asp-action="Index" class="btn btn-light text-primary fw-bold px-4 rounded-pill">Manage Borrowings</a>
    </div>
</div>

<!-- Stats Row -->
<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="card h-100 shadow-sm border-0 hover-lift">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted mb-1 text-uppercase fw-semibold" style="font-size: 0.85rem;">Total Books</p>
                        <h3 class="mb-0 fw-bold">@Model.TotalBooks</h3>
                    </div>
                    <div class="bg-primary-light p-2 rounded">
                        <i class="bi bi-journal-bookmark text-primary fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card h-100 shadow-sm border-0 hover-lift">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted mb-1 text-uppercase fw-semibold" style="font-size: 0.85rem;">Students</p>
                        <h3 class="mb-0 fw-bold">@Model.TotalStudents</h3>
                    </div>
                    <div class="bg-success-light p-2 rounded">
                        <i class="bi bi-people text-success fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card h-100 shadow-sm border-0 hover-lift">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted mb-1 text-uppercase fw-semibold" style="font-size: 0.85rem;">Overdue Books</p>
                        <h3 class="mb-0 fw-bold text-danger">@Model.OverdueBooks</h3>
                    </div>
                    <div class="bg-danger-light p-2 rounded">
                        <i class="bi bi-exclamation-triangle text-danger fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card h-100 shadow-sm border-0 hover-lift">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted mb-1 text-uppercase fw-semibold" style="font-size: 0.85rem;">Fines Collected</p>
                        <h3 class="mb-0 fw-bold text-success">@Model.FineCollection.ToString("C")</h3>
                    </div>
                    <div class="bg-warning-light p-2 rounded">
                        <i class="bi bi-cash-coin text-warning fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Recent Borrowings -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0 fw-bold">Recent Borrowings</h5>
                <a asp-controller="Borrow" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Student</th>
                                <th>Book</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in Model.RecentBorrowings)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar bg-primary text-white d-flex align-items-center justify-content-center me-3 shadow-sm" style="font-size: 1.1rem;">
                                                @(string.IsNullOrEmpty(record.User) ? "?" : record.User.Substring(0, 1).ToUpper())
                                            </div>
                                            <span class="fw-semibold">@record.User</span>
                                        </div>
                                    </td>
                                    <td>@record.Book</td>
                                    <td>@record.Date.ToLocalTime().ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @if (record.Status == "Issued")
                                        {
                                            <span class="badge bg-primary-light">@record.Status</span>
                                        }
                                        else if (record.Status == "Returned")
                                        {
                                            <span class="badge bg-success-light">@record.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@record.Status</span>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!Model.RecentBorrowings.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No recent activity.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Recently Added Books -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0 fw-bold">Recently Added Books</h5>
                <a asp-controller="Books" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @foreach (var book in Model.RecentlyAddedBooks)
                    {
                        <li class="list-group-item px-4 py-3 d-flex justify-content-between align-items-center hover-lift">
                            <div class="d-flex align-items-center">
                                @if (!string.IsNullOrEmpty(book.ImageUrl))
                                {
                                    <img src="@book.ImageUrl" alt="@book.Title" class="rounded me-3 shadow-sm" style="width: 45px; height: 65px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="bg-light d-flex align-items-center justify-content-center rounded me-3 shadow-sm" style="width: 45px; height: 65px;">
                                        <i class="bi bi-book text-muted"></i>
                                    </div>
                                }
                                <div>
                                    <h6 class="mb-1 fw-bold">@book.Title</h6>
                                    <small class="text-muted">By @book.Author</small>
                                </div>
                            </div>
                            @if (book.IsAvailable)
                            {
                                <span class="badge bg-success-light rounded-pill">Available</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-light rounded-pill">Out</span>
                            }
                        </li>
                    }
                    @if (!Model.RecentlyAddedBooks.Any())
                    {
                        <li class="list-group-item text-center py-4 text-muted">No books added yet.</li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
