@model LMSystem.Web.Models.ApplicationUser
@{
    ViewData["Title"] = "Delete Librarian";
}
<div class="row mb-4"><div class="col"><h2>Delete Librarian</h2><h4 class="text-danger">Are you sure you want to delete this?</h4></div></div>
<div class="card shadow-sm"><div class="card-body">
    <dl class="row">
        <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div></div>
