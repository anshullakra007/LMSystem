@model LMSystem.Web.Models.Newspaper
@{
    ViewData["Title"] = "Add Newspaper";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Add New Newspaper</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to Catalog</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-newspaper me-2 text-primary"></i>Newspaper Details</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" class="needs-validation">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>
                    
                    <div class="form-floating mb-4">
                        <input asp-for="Name" class="form-control" placeholder="Name" required />
                        <label asp-for="Name">Name <span class="text-danger">*</span></label>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Date" class="form-control" type="date" required />
                                <label asp-for="Date">Date <span class="text-danger">*</span></label>
                                <span asp-validation-for="Date" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Quantity" class="form-control" type="number" min="1" placeholder="Quantity" required />
                                <label asp-for="Quantity">Quantity <span class="text-danger">*</span></label>
                                <span asp-validation-for="Quantity" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end border-top pt-4">
                        <a asp-action="Index" class="btn btn-light me-2">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-2"></i> Save Newspaper</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
