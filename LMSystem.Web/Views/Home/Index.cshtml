@{
    ViewData["Title"] = "Home Page";
}

<div class="px-4 py-5 my-5 text-center">
    <h1 class="display-5 fw-bold text-body-emphasis">Library Management System</h1>
    <div class="col-lg-6 mx-auto">
        <p class="lead mb-4">Welcome to the modern Library Management System. Please login to access the dashboard, manage books, or borrow items.</p>
        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-4 gap-3">Login</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-secondary btn-lg px-4">Register</a>
        </div>
    </div>
</div>
