@{
    ViewData["Title"] = "System Error";
}

<div class="d-flex align-items-center justify-content-center vh-100 mt-n5">
    <div class="text-center">
        <h1 class="display-1 fw-bold text-warning"><i class="bi bi-exclamation-triangle"></i></h1>
        <h2 class="mb-4">Oops! Something went wrong.</h2>
        <p class="text-muted mb-4 fs-5">We're experiencing some technical difficulties. Our team has been notified.</p>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4 rounded-pill">
            <i class="bi bi-arrow-left me-2"></i>Return to Dashboard
        </a>
    </div>
</div>
