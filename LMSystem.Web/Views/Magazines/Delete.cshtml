@model LMSystem.Web.Models.Magazine
@{
    ViewData["Title"] = "Delete Magazine";
}
<div class="row mb-4"><div class="col"><h2>Delete Magazine</h2><h4 class="text-danger">Are you sure you want to delete this?</h4></div></div>
<div class="card shadow-sm"><div class="card-body">
    <dl class="row">
        <dt class="col-sm-3">Title</dt><dd class="col-sm-9">@Model.Title</dd>
        <dt class="col-sm-3">Publisher ID</dt><dd class="col-sm-9">@Model.PublisherId</dd>
        <dt class="col-sm-3">Issue Date</dt><dd class="col-sm-9">@Model.IssueDate.ToLocalTime().ToString("MMM dd, yyyy")</dd>
        <dt class="col-sm-3">Quantity</dt><dd class="col-sm-9">@Model.Quantity</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div></div>
