<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LMSystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LMSystem.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div id="loadingOverlay">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="wrapper">
            <!-- Sidebar  -->
            <nav id="sidebar">
                <div class="sidebar-header">
                    <h4><i class="bi bi-book-half me-2"></i>LMSystem</h4>
                </div>
                <ul class="list-unstyled components">
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")">
                        <a asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i> Dashboard</a>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Books" ? "active" : "")">
                        <a asp-controller="Books" asp-action="Index"><i class="bi bi-book me-2"></i> Books</a>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Borrow" ? "active" : "")">
                        <a asp-controller="Borrow" asp-action="Index"><i class="bi bi-arrow-left-right me-2"></i> Borrowing</a>
                    </li>
                    @if (User.IsInRole("Admin") || User.IsInRole("Librarian"))
                    {
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Students" ? "active" : "")">
                            <a asp-controller="Students" asp-action="Index"><i class="bi bi-people me-2"></i> Students</a>
                        </li>
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reports" ? "active" : "")">
                            <a asp-controller="Reports" asp-action="Index">
                                <i class="bi bi-bar-chart me-2"></i> Reports
                            </a>
                        </li>
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Authors" || ViewContext.RouteData.Values["Controller"]?.ToString() == "Categories" ? "active" : "")">
                            <a href="#catalogsSubmenu" data-bs-toggle="collapse" aria-expanded="false" class="dropdown-toggle">
                                <i class="bi bi-tags me-2"></i> Catalogs
                            </a>
                            <ul class="collapse list-unstyled" id="catalogsSubmenu">
                                <li><a asp-controller="Authors" asp-action="Index" class="ps-5">Authors</a></li>
                                <li><a asp-controller="Categories" asp-action="Index" class="ps-5">Categories</a></li>
                                <li><a asp-controller="Publishers" asp-action="Index" class="ps-5">Publishers</a></li>
                                <li><a asp-controller="Magazines" asp-action="Index" class="ps-5">Magazines</a></li>
                                <li><a asp-controller="Newspapers" asp-action="Index" class="ps-5">Newspapers</a></li>
                            </ul>
                        </li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Librarians" ? "active" : "")">
                            <a asp-controller="Librarians" asp-action="Index"><i class="bi bi-shield-lock me-2"></i> Librarians</a>
                        </li>
                    }
                </ul>
            </nav>

            <!-- Page Content  -->
            <div id="content">
                <nav class="navbar navbar-expand-lg navbar-light bg-light mb-4 shadow-sm rounded">
                    <div class="container-fluid">
                        <button type="button" id="sidebarCollapse" class="btn btn-primary d-md-none">
                            <i class="bi bi-list"></i>
                        </button>
                        <div class="ms-auto d-flex align-items-center">
                            <partial name="_LoginPartial" />
                        </div>
                    </div>
                </nav>
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Public Layout (Login/Register) -->
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4 shadow-sm">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-book-half me-2"></i>Library Management System
                </a>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
        <div class="container">
            @RenderBody()
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            // Sidebar toggle for mobile
            $('#sidebarCollapse').on('click', function () {
                $('#sidebar').toggleClass('d-none');
            });
            
            // Show loading spinner on form submissions (unless disabled or has ignore class)
            $('form:not(.no-spinner)').on('submit', function() {
                if ($(this).valid && !$(this).valid()) return; // Don't show if validation fails
                $('#loadingOverlay').css('display', 'flex');
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    <partial name="_Toasts" />
</body>
</html>
