@model LMSystem.Web.ViewModels.BookListViewModel
@{
    ViewData["Title"] = "Books Directory";
}

<!-- Summary Dashboard Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="card shadow-sm border-0 bg-primary bg-gradient text-white h-100 rounded-3">
            <div class="card-body d-flex align-items-center">
                <div class="display-6 me-3"><i class="bi bi-collection"></i></div>
                <div>
                    <h6 class="mb-0 text-white-50 text-uppercase fw-bold" style="font-size: 0.8rem;">Total Books</h6>
                    <h3 class="mb-0 fw-bold">@Model.TotalBooks</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card shadow-sm border-0 bg-success bg-gradient text-white h-100 rounded-3">
            <div class="card-body d-flex align-items-center">
                <div class="display-6 me-3"><i class="bi bi-check-circle"></i></div>
                <div>
                    <h6 class="mb-0 text-white-50 text-uppercase fw-bold" style="font-size: 0.8rem;">Available</h6>
                    <h3 class="mb-0 fw-bold">@Model.AvailableBooks</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card shadow-sm border-0 bg-info bg-gradient text-white h-100 rounded-3">
            <div class="card-body d-flex align-items-center">
                <div class="display-6 me-3"><i class="bi bi-arrow-left-right"></i></div>
                <div>
                    <h6 class="mb-0 text-white-50 text-uppercase fw-bold" style="font-size: 0.8rem;">Borrowed</h6>
                    <h3 class="mb-0 fw-bold">@Model.BorrowedBooks</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card shadow-sm border-0 bg-danger bg-gradient text-white h-100 rounded-3">
            <div class="card-body d-flex align-items-center">
                <div class="display-6 me-3"><i class="bi bi-exclamation-octagon"></i></div>
                <div>
                    <h6 class="mb-0 text-white-50 text-uppercase fw-bold" style="font-size: 0.8rem;">Out of Stock</h6>
                    <h3 class="mb-0 fw-bold">@Model.OutOfStockBooks</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0 fw-bold text-dark">Library Catalog</h2>
    @if (User.IsInRole("Admin") || User.IsInRole("Librarian"))
    {
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm fw-semibold">
            <i class="bi bi-plus-lg me-1"></i> Add Book
        </a>
    }
</div>

<div class="card mb-4 shadow-sm border-0 rounded-3">
    <div class="card-body p-4">
        <form asp-action="Index" method="get" class="d-flex w-100">
            <div class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden border">
                <span class="input-group-text bg-white border-0 text-primary px-4"><i class="bi bi-search"></i></span>
                <input type="text" name="searchTerm" class="form-control border-0 px-2" placeholder="Search books by title, author, or ISBN..." value="@Model.SearchTerm">
                <button class="btn btn-primary px-4 fw-semibold border-0" type="submit">Search</button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <a asp-action="Index" class="btn btn-light px-4 border-start">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-3 overflow-hidden">
    <div class="table-responsive" style="max-height: 65vh;">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-light sticky-top shadow-sm z-1">
                <tr>
                    <th class="ps-4 border-0 py-3 text-uppercase text-secondary" style="font-size: 0.85rem; width: 80px;">Cover</th>
                    <th class="border-0 py-3 text-uppercase text-secondary" style="font-size: 0.85rem;">Title</th>
                    <th class="border-0 py-3 text-uppercase text-secondary" style="font-size: 0.85rem;">Author</th>
                    <th class="border-0 py-3 text-uppercase text-secondary" style="font-size: 0.85rem;">Category</th>
                    <th class="border-0 py-3 text-uppercase text-secondary" style="font-size: 0.85rem;">ISBN</th>
                    <th class="border-0 py-3 text-uppercase text-secondary text-center" style="font-size: 0.85rem;">Stock</th>
                    <th class="text-end pe-4 border-0 py-3 text-uppercase text-secondary" style="font-size: 0.85rem;">Actions</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
                @foreach (var item in Model.Books)
                {
                    <tr class="align-middle transition-all">
                        <td class="ps-4 py-3">
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/book-placeholder.png" : item.ImageUrl)" 
                                 onerror="this.onerror=null;this.src='/images/book-placeholder.png';"
                                 alt="Cover of @item.Title" 
                                 class="rounded shadow-sm border border-light" 
                                 style="width: 60px; height: 90px; object-fit: cover; background-color: #f8f9fa;" />
                        </td>
                        <td class="py-3">
                            <div class="fw-bold text-dark fs-6 mb-1">@item.Title</div>
                            <small class="text-muted"><i class="bi bi-clock me-1"></i>Published: @item.PublishedYear</small>
                        </td>
                        <td class="py-3">
                            <span class="d-inline-block text-truncate" style="max-width: 150px;">@item.Author?.Name</span>
                        </td>
                        <td class="py-3">
                            <span class="badge bg-light text-dark border px-2 py-1">@item.Category?.Name</span>
                        </td>
                        <td class="py-3 font-monospace text-muted small">@item.ISBN</td>
                        <td class="py-3 text-center">
                            @if (item.AvailableQuantity >= 3)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill px-3 py-2 fw-semibold">
                                    <i class="bi bi-check-circle me-1"></i> @item.AvailableQuantity / @item.Quantity
                                </span>
                            }
                            else if (item.AvailableQuantity > 0)
                            {
                                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning rounded-pill px-3 py-2 fw-semibold">
                                    <i class="bi bi-exclamation-triangle me-1"></i> @item.AvailableQuantity / @item.Quantity
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger rounded-pill px-3 py-2 fw-semibold">
                                    <i class="bi bi-x-circle me-1"></i> Out of Stock
                                </span>
                            }
                        </td>
                        <td class="text-end pe-4 py-3">
                            <div class="btn-group shadow-sm rounded-pill overflow-hidden">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light border-end text-primary hover-primary" data-bs-toggle="tooltip" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (User.IsInRole("Admin") || User.IsInRole("Librarian"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light border-end text-warning hover-warning" data-bs-toggle="tooltip" title="Edit Book">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline m-0 p-0" onsubmit="return confirm('Are you sure you want to delete @item.Title?');">
                                        <button type="submit" class="btn btn-sm btn-light text-danger hover-danger rounded-0 rounded-end" data-bs-toggle="tooltip" title="Delete Book">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                                @if (User.IsInRole("Student"))
                                {
                                    <a asp-controller="Borrow" asp-action="Issue" asp-route-bookId="@item.Id" class="btn btn-sm btn-primary rounded-0 rounded-end fw-semibold @(item.AvailableQuantity <= 0 ? "disabled" : "")" data-bs-toggle="tooltip" title="Borrow this book">
                                        <i class="bi bi-journal-plus me-1"></i> Borrow
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Books.Any())
                {
                    <tr>
                        <td colspan="7" class="py-5 text-center">
                            <div class="empty-state py-4">
                                <div class="display-1 text-muted mb-3 opacity-25"><i class="bi bi-journal-x"></i></div>
                                <h4 class="fw-bold text-dark">No books found</h4>
                                <p class="text-muted">We couldn't find any books matching your criteria.</p>
                                @if (User.IsInRole("Admin") || User.IsInRole("Librarian"))
                                {
                                    <a asp-action="Create" class="btn btn-primary mt-2 rounded-pill px-4"><i class="bi bi-plus-lg me-1"></i> Add a Book Now</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    @if (Model.TotalPages > 0)
    {
        <div class="card-footer bg-white border-top-0 py-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div class="text-muted small mb-2 mb-md-0 ps-2">
                    Showing page <strong>@Model.CurrentPage</strong> of <strong>@Model.TotalPages</strong>
                </div>
                
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Book pagination" class="m-0 pe-2">
                        <ul class="pagination pagination-sm m-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link rounded-start" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchTerm="@Model.SearchTerm">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            
                            @{
                                // Show at most 5 page links
                                int startPage = Math.Max(1, Model.CurrentPage - 2);
                                int endPage = Math.Min(Model.TotalPages, startPage + 4);
                                if (endPage - startPage < 4 && Model.TotalPages >= 5)
                                {
                                    startPage = Math.Max(1, endPage - 4);
                                }
                            }
                            
                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchTerm="@Model.SearchTerm">@i</a>
                                </li>
                            }
                            
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link rounded-end" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchTerm="@Model.SearchTerm">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(function () {
            $('[data-bs-toggle="tooltip"]').tooltip();
        });
    </script>
}
