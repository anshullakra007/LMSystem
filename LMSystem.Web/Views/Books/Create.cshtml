@model LMSystem.Web.Models.Book
@{
    ViewData["Title"] = "Add New Book";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Add New Book</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to Catalog</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-book me-2 text-primary"></i>Book Details</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" class="needs-validation">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>
                    
                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <div class="form-floating">
                                <input asp-for="Title" class="form-control" placeholder="Book Title" required />
                                <label asp-for="Title">Book Title <span class="text-danger">*</span></label>
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating">
                                <input asp-for="ISBN" class="form-control" placeholder="ISBN Number" required />
                                <label asp-for="ISBN">ISBN <span class="text-danger">*</span></label>
                                <span asp-validation-for="ISBN" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-floating mb-3">
                        <textarea asp-for="Description" class="form-control" placeholder="Description" style="height: 100px"></textarea>
                        <label asp-for="Description">Description</label>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="ImageUrl" class="form-control" placeholder="Cover Image URL" />
                        <label asp-for="ImageUrl">Cover Image URL</label>
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <div class="form-floating">
                                <select asp-for="AuthorId" class="form-select" asp-items="ViewBag.AuthorId" required>
                                    <option value="">-- Select Author --</option>
                                </select>
                                <label asp-for="AuthorId">Author <span class="text-danger">*</span></label>
                                <span asp-validation-for="AuthorId" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating">
                                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId" required>
                                    <option value="">-- Select Category --</option>
                                </select>
                                <label asp-for="CategoryId">Category <span class="text-danger">*</span></label>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating">
                                <select asp-for="PublisherId" class="form-select" asp-items="ViewBag.PublisherId" required>
                                    <option value="">-- Select Publisher --</option>
                                </select>
                                <label asp-for="PublisherId">Publisher <span class="text-danger">*</span></label>
                                <span asp-validation-for="PublisherId" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <div class="form-floating">
                                <input asp-for="Quantity" class="form-control" type="number" min="1" placeholder="Quantity" required />
                                <label asp-for="Quantity">Total Copies <span class="text-danger">*</span></label>
                                <span asp-validation-for="Quantity" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-floating">
                                <input asp-for="PublishedYear" class="form-control" type="number" placeholder="Year" />
                                <label asp-for="PublishedYear">Published Year</label>
                                <span asp-validation-for="PublishedYear" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-floating">
                                <input asp-for="Edition" class="form-control" placeholder="Edition" />
                                <label asp-for="Edition">Edition</label>
                                <span asp-validation-for="Edition" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-floating">
                                <input asp-for="ShelfLocation" class="form-control" placeholder="Shelf Location" />
                                <label asp-for="ShelfLocation">Shelf Location</label>
                                <span asp-validation-for="ShelfLocation" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end border-top pt-4">
                        <a asp-action="Index" class="btn btn-light me-2">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-2"></i> Save Book</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
