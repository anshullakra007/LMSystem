@model LMSystem.Web.Models.Book
@{
    ViewData["Title"] = Model.Title;
}

<div class="row mb-4">
    <div class="col">
        <h2>Book Details</h2>
    </div>
    <div class="col-auto">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to Catalog</a>
        @if (User.IsInRole("Admin") || User.IsInRole("Librarian"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning ms-2"><i class="bi bi-pencil"></i> Edit Book</a>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-5">
        <div class="row">
            <div class="col-md-8">
                <h3 class="display-5 mb-1">@Model.Title</h3>
                <p class="text-muted fs-5 mb-4">by <strong>@Model.Author?.Name</strong></p>
                
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="mb-4">
                        <h5>Description</h5>
                        <p>@Model.Description</p>
                    </div>
                }

                <div class="row g-4 mb-4">
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded border border-light-subtle">
                            <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.8rem;"><i class="bi bi-tag me-1"></i>Category</h6>
                            <p class="mb-0 fw-semibold">@Model.Category?.Name</p>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded border border-light-subtle">
                            <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.8rem;"><i class="bi bi-building me-1"></i>Publisher</h6>
                            <p class="mb-0 fw-semibold">@Model.Publisher?.Name</p>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded border border-light-subtle">
                            <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.8rem;"><i class="bi bi-upc-scan me-1"></i>ISBN</h6>
                            <p class="mb-0 fw-semibold">@Model.ISBN</p>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded border border-light-subtle">
                            <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.8rem;"><i class="bi bi-calendar3 me-1"></i>Published Year</h6>
                            <p class="mb-0 fw-semibold">@(Model.PublishedYear?.ToString() ?? "N/A")</p>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded border border-light-subtle">
                            <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.8rem;"><i class="bi bi-translate me-1"></i>Language</h6>
                            <p class="mb-0 fw-semibold">@(Model.Language ?? "N/A")</p>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded border border-light-subtle">
                            <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.8rem;"><i class="bi bi-journal-bookmark-fill me-1"></i>Edition</h6>
                            <p class="mb-0 fw-semibold">@(Model.Edition ?? "N/A")</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card bg-light border-0 mb-4">
                    <div class="card-body">
                        <h4 class="card-title mb-4">Availability</h4>
                        
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Total Copies</span>
                            <span class="fw-bold fs-5">@Model.Quantity</span>
                        </div>
                        
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Available</span>
                            <span class="fw-bold fs-5 @(Model.AvailableQuantity > 0 ? "text-success" : "text-danger")">
                                @Model.AvailableQuantity
                            </span>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Shelf Location</span>
                            <span class="fw-bold">@(Model.ShelfLocation ?? "Not Assigned")</span>
                        </div>
                    </div>
                </div>

                <div class="d-grid">
                    @if (Model.AvailableQuantity > 0)
                    {
                        <a asp-controller="Borrow" asp-action="Issue" asp-route-bookId="@Model.Id" class="btn btn-primary btn-lg"><i class="bi bi-bookmark-check me-2"></i>Issue Book</a>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-lg" disabled><i class="bi bi-x-circle me-2"></i>Not Available</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
