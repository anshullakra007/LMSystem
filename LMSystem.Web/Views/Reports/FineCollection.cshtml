@model IEnumerable<LMSystem.Web.Models.BorrowRecord>
@{
    ViewData["Title"] = "Fine Collection";
}

<div class="row mb-4">
    <div class="col">
        <h2>Fine Collection Report</h2>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 border-start border-primary border-4">
            <div class="card-body">
                <p class="text-muted mb-1 text-uppercase fw-semibold" style="font-size: 0.85rem;">Total Fines Generated</p>
                <h3 class="mb-0 fw-bold text-primary">@Model.Sum(f => f.FineAmount).ToString("C")</h3>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 border-start border-success border-4">
            <div class="card-body">
                <p class="text-muted mb-1 text-uppercase fw-semibold" style="font-size: 0.85rem;">Total Fines Collected</p>
                <h3 class="mb-0 fw-bold text-success">@Model.Where(f => f.Status == "FinePaid").Sum(f => f.FineAmount).ToString("C")</h3>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 border-start border-danger border-4">
            <div class="card-body">
                <p class="text-muted mb-1 text-uppercase fw-semibold" style="font-size: 0.85rem;">Outstanding Fines</p>
                <h3 class="mb-0 fw-bold text-danger">@Model.Where(f => f.Status != "FinePaid").Sum(f => f.FineAmount).ToString("C")</h3>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Student</th>
                        <th>Book</th>
                        <th>Return Date</th>
                        <th>Fine Amount</th>
                        <th class="text-end pe-4">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">@item.User?.Name (@item.User?.Email)</td>
                            <td>@item.Book?.Title</td>
                            <td>@(item.ReturnDate?.ToLocalTime().ToString("MMM dd, yyyy") ?? "-")</td>
                            <td class="fw-bold">@item.FineAmount.ToString("C")</td>
                            <td class="text-end pe-4">
                                @if (item.Status == "FinePaid")
                                {
                                    <span class="badge bg-success-light rounded-pill"><i class="bi bi-check-circle-fill me-1"></i> Paid</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-light rounded-pill"><i class="bi bi-exclamation-circle-fill me-1"></i> Unpaid</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5">
                                <div class="empty-state">
                                    <i class="bi bi-cash-coin"></i>
                                    <h4>No fines recorded</h4>
                                    <p>There are currently no fines in the system.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
