@model LMSystem.Web.Models.Author
@{
    ViewData["Title"] = "Delete Author";
}
<div class="row mb-4"><div class="col"><h2>Delete Author</h2><h4 class="text-danger">Are you sure you want to delete this?</h4></div></div>
<div class="card shadow-sm"><div class="card-body">
    <dl class="row">
        <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Biography</dt><dd class="col-sm-9">@Model.Biography</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div></div>
