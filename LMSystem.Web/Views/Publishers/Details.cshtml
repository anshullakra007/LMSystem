@model LMSystem.Web.Models.Publisher
@{
    ViewData["Title"] = "Publisher Details";
}
<div class="row mb-4"><div class="col"><h2>Publisher Details</h2></div></div>
<div class="card shadow-sm"><div class="card-body">
    <dl class="row">
        <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Address</dt><dd class="col-sm-9">@Model.Address</dd>
    </dl>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
    </div>
</div></div>
