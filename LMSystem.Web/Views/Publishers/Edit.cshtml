@model LMSystem.Web.Models.Publisher
@{
    ViewData["Title"] = "Edit Publisher";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Edit Publisher</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to Catalog</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2 text-warning"></i>Edit Publisher Details</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" class="needs-validation">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="form-floating mb-4">
                        <input asp-for="Name" class="form-control" placeholder="Name" required />
                        <label asp-for="Name">Name <span class="text-danger">*</span></label>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <textarea asp-for="Address" class="form-control" placeholder="Address" style="height: 120px"></textarea>
                        <label asp-for="Address">Address</label>
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end border-top pt-4">
                        <a asp-action="Index" class="btn btn-light me-2">Cancel</a>
                        <button type="submit" class="btn btn-warning px-4"><i class="bi bi-save me-2"></i> Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
